# Copy this file to .env and adjust values. Never commit .env.
PORT=5000
# Local MongoDB (install MongoDB Community Server) ...
MONGODB_URI=mongodb://127.0.0.1:27017/success_scholar
# ... or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/success_scholar?retryWrites=true&w=majority
# Optional: use comma-separated DNS resolvers if your network's DNS blocks MongoDB SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Demo admin created by the seed script
ADMIN_EMAIL=admin@successscholar.demo
ADMIN_PASSWORD=Admin@12345
